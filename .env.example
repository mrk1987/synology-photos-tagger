# Copy to .env and fill in. Never commit .env.

# Synology Photos database (synofoto). Usually reached through an SSH tunnel, see docs/SETUP.md.
SPT_PG_DSN=host=127.0.0.1 port=15432 dbname=synofoto user=tagger
SPT_PG_PASSWORD=

# Your Synology Photos user name (Personal Space) and where its Photos folder is mounted
# read-only on this machine (the NAS path is /volume1/homes/<user>/Photos).
SPT_SYNO_USER=
SPT_PHOTOS_ROOT=/photos

# Local work data: face embeddings (biometric data) and tags. Keep it private.
SPT_DATA_DIR=/var/lib/synology-photos-tagger

# Vision service. Generate a token with: python -c "import secrets; print(secrets.token_hex(32))"
SPT_VISION_URL=http://127.0.0.1:8095
SPT_VISION_TOKEN=
SPT_MODEL_DIR=/opt/synology-photos-tagger/models
# 1 on GPUs with 4-6 GB (tested on a GTX 1650 4 GB shared with Plex). On 4 GB the tag model
# usually does not fit next to the face models and falls back to CPU automatically (~2-8 s/photo,
# fine for nightly runs; do the first full run on a bigger GPU if you have one).
SPT_LOW_VRAM=0
# gpu or cpu. On 4 GB cards use cpu: frees ~1.8 GB VRAM and is fast enough for nightly runs.
SPT_TAGS_DEVICE=gpu

# Tuning (defaults are what was tested)
SPT_CLUSTER_DIST=0.65
SPT_ATTACH=0.45
SPT_MAX_TAGS=15
